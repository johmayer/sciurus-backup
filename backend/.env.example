# Required: Database connection string (SQLite)
DATABASE_URL="sqlite:../data/sciurus.db"

# Required: Generate a secure secret for session encryption (e.g., openssl rand -base64 32)
AUTH_SECRET="change_this_to_a_random_secure_string_in_production"

# Required: Encryption key for securing config.yaml secrets (e.g., openssl rand -base64 32)
CONFIG_ENCRYPTION_KEY="base64_encoded_secure_key_for_rclone_secrets"

# Optional: Path to your GitOps config file (default: config.yaml)
CONFIG_PATH="./config.yaml"

# Optional: OAuth2 / OpenID Connect (OIDC) Configuration
# DISABLE_LOCAL_AUTH="true"
# OIDC_ISSUER="https://authentik.example.com/application/o/sciurus/"
# OIDC_CLIENT_ID="your_client_id"
# OIDC_CLIENT_SECRET="your_client_secret"
# OIDC_NAME="Authentik"
# OIDC_WELL_KNOWN_URL="https://authentik.example.com/application/o/sciurus/.well-known/openid-configuration"
